{
  "name": "bot-setter-instagram",
  "version": "1.0.0",
  "description": "Bot setter para Instagram conectado a ManyChat: entiende texto, audios e imágenes, califica leads y agenda llamadas de venta con Claude.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "chat": "tsx src/scripts/chat.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "analisis": "tsx src/scripts/analisis.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NachBotas/Bot-de-instagram.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/NachBotas/Bot-de-instagram/issues"
  },
  "homepage": "https://github.com/NachBotas/Bot-de-instagram#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "private": true
}
