# Copiá este archivo como .env y completalo.

# ── Servidor ──────────────────────────────────────────────
PORT=3000
# Secreto que ManyChat manda en el header X-Webhook-Secret (inventá uno largo).
WEBHOOK_SECRET=cambia-esto-por-algo-largo-y-secreto
# Token para el panel /admin (opcional). Header: Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=

# ── Claude (el cerebro del setter) ────────────────────────
# Sacala en https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# Cuánto "piensa" antes de responder: low (rápido, ideal para chat) | medium | high
CLAUDE_EFFORT=low

# ── ManyChat ──────────────────────────────────────────────
# ManyChat → Settings → API → Generate your API Key
MANYCHAT_API_KEY=
# true = no manda nada a ManyChat, solo imprime en consola (para probar)
MANYCHAT_DRY_RUN=false
# Si un contacto tiene este tag en ManyChat, el bot no le responde (lo atiende un humano)
PAUSE_TAG=bot_pausado

# ── Audios (notas de voz) ─────────────────────────────────
# groq (recomendado: rápido y barato) | openai | deepgram | none
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
TRANSCRIPTION_LANGUAGE=es

# ── Agenda de llamadas ────────────────────────────────────
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires
# Opción A (recomendada): el bot ofrece horarios y agenda solo, con Cal.com
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
# Opción B: el bot manda tu link (Calendly, Cal.com, etc.). Se usa si no hay Cal.com configurado.
BOOKING_LINK=https://calendly.com/tu-usuario/llamada
# (Opcional) Flow de ManyChat que se dispara cuando alguien agenda (confirmación, recordatorios…)
FLOW_BOOKED_NS=

# ── Comportamiento ────────────────────────────────────────
# Segundos que espera por si el lead manda varios mensajes seguidos
DEBOUNCE_SECONDS=7
# Pausa base entre burbujas (ms), para que parezca alguien escribiendo
TYPING_DELAY_MS=1500
MAX_BUBBLES=4
# Seguimiento automático si el lead deja de responder (siempre dentro de la ventana de 24 h)
FOLLOWUP_ENABLED=true
FOLLOWUP_AFTER_HOURS=6
FOLLOWUP_MAX=1
# (Opcional) URL que recibe un POST cuando el bot deriva a un humano (Slack, Make, Zapier, n8n…)
HANDOFF_WEBHOOK_URL=

# ── Archivos ──────────────────────────────────────────────
DATA_DIR=./data
BUSINESS_FILE=./config/negocio.md
AUTOMATIONS_FILE=./config/automatizaciones.json
